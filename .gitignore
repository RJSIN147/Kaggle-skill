# Skill-package hygiene (repo root).
# NOTE: this is the kaggle-exp SKILL repo's .gitignore — distinct from the
# workspace .gitignore that `kx init` writes into a competition folder
# (src/kx/templates/gitignore.tmpl). uv.lock IS tracked (reproducible env).

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Test / tooling caches
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

.claude/
.planning/
