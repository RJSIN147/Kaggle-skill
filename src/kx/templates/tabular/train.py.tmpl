def main():
    train, test = _load()
    if "prepare" in globals():  # optional AI hook: derive targets, join extra files
        train, test = globals()["prepare"](train, test)
    out = _output_dir()
    y = train[TARGET]
    classification = METRIC_INFO["prediction_type"] in ("proba", "label")
    classes = sorted(pd.unique(y).tolist()) if classification else None
    # Fit on integer class codes (0..K-1, the sorted class order) so any sklearn-API model
    # works with string labels; scoring keeps the original labels.
    y_fit = pd.Series(pd.Categorical(y, categories=classes).codes, index=y.index) \
        if classification else y
    folds = np.asarray(assign_folds(train, y), dtype=int)
    assert folds.shape == (len(train),), "assign_folds must return one fold id per train row"
    used = sorted(int(f) for f in np.unique(folds) if f >= 0)
    assert used == list(range(N_FOLDS)), f"folds used {used} != range({N_FOLDS})"
    X, X_test = build_features(train, test)

    n_cols = len(classes) if classification and len(classes) > 2 else 1
    oof = np.full((len(train), n_cols), np.nan)
    test_pred = np.zeros((len(test), n_cols))
    fold_scores = []
    for k in used:
        tr, va = folds != k, folds == k
        model = make_model(SEED + k)
        model.fit(X[tr], y_fit[tr])
        _save_model(model, f"fold{k}")
        if classification:
            p_va, p_te = model.predict_proba(X[va]), model.predict_proba(X_test)
            if n_cols == 1:
                p_va, p_te = p_va[:, 1], p_te[:, 1]
        else:
            p_va, p_te = model.predict(X[va]), model.predict(X_test)
        oof[va] = np.asarray(p_va).reshape(-1, n_cols)
        test_pred += np.asarray(p_te).reshape(-1, n_cols) / len(used)
        fold_scores.append(_score(y[va], p_va, classes, train[va]))
        print(f"fold {k}: {METRIC}={fold_scores[-1]:.6f}", flush=True)

    _write_outputs(out, train=train, test=test, y=y, folds=folds, oof=oof, test_pred=test_pred,
                   fold_scores=fold_scores, classes=classes, classification=classification)


main()
