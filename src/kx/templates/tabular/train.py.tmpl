# === AI BLOCK: write the CV scheme, features and model for this idea ===========
def assign_folds(train: pd.DataFrame, y: pd.Series) -> np.ndarray:
    """Return an int fold id per train row in [0, N_FOLDS), or -1 for rows never
    used for validation. This IS the CV scheme: match how the test set differs
    from train (stratify a rare target, group by entity, split by time...)."""
    from sklearn.model_selection import KFold, StratifiedKFold

    folds = np.full(len(train), -1, dtype=int)
    if METRIC_INFO["prediction_type"] == "raw":
        splitter = KFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
    else:
        splitter = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
    for k, (_, va) in enumerate(splitter.split(train, y)):
        folds[va] = k
    return folds


def build_features(train: pd.DataFrame, test: pd.DataFrame):
    """Return (X_train, X_test) with identical columns. Fit nothing on the
    validation fold here: anything learned from targets belongs in the model."""
    X = train.drop(columns=[c for c in (TARGET, ID_COL) if c in train.columns])
    X_test = test[[c for c in X.columns if c in test.columns]].copy()
    X = X[X_test.columns]
    for col in X.columns:
        if not pd.api.types.is_numeric_dtype(X[col]) and not pd.api.types.is_bool_dtype(X[col]):
            cats = pd.Categorical(pd.concat([X[col], X_test[col]], ignore_index=True).astype(str))
            X[col] = pd.Categorical(X[col].astype(str), categories=cats.categories)
            X_test[col] = pd.Categorical(X_test[col].astype(str), categories=cats.categories)
    return X, X_test


def make_model(seed: int):
    """A fresh, unfitted estimator with fit / predict (and predict_proba for
    classification)."""
    import lightgbm as lgb

    if METRIC_INFO["prediction_type"] == "raw":
        return lgb.LGBMRegressor(n_estimators=400, learning_rate=0.05, random_state=seed, verbose=-1)
    return lgb.LGBMClassifier(n_estimators=400, learning_rate=0.05, random_state=seed, verbose=-1)


