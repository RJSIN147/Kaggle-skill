# === AI BLOCK: write the walk-forward scheme, features and model ================
def assign_folds(train: pd.DataFrame, y: pd.Series, test: pd.DataFrame) -> np.ndarray:
    """Walk-forward folds: N_FOLDS consecutive windows at the end of train, each as
    long as the test period. Fold k validates window k; rows before window 0 are
    -1 (train-only). Folds must be in time order: fold k trains on folds < k."""
    t = pd.to_datetime(train[TIME_COL])
    t_test = pd.to_datetime(test[TIME_COL])
    horizon = (t_test.max() - t_test.min()) + pd.Timedelta(days=1)
    end = t.max() + pd.Timedelta(days=1)
    folds = np.full(len(train), -1, dtype=int)
    for k in range(N_FOLDS):
        lo = end - (N_FOLDS - k) * horizon
        hi = lo + horizon
        folds[((t >= lo) & (t < hi)).to_numpy()] = k
    return folds


def build_features(train: pd.DataFrame, test: pd.DataFrame):
    """Return (X_train, X_test). Lag/rolling features must only use the past:
    build them on train+test sorted by time, shifted by at least the horizon."""
    both = pd.concat([train.drop(columns=[TARGET]), test], ignore_index=True)
    d = pd.to_datetime(both[TIME_COL])
    both["dow"], both["dom"], both["month"] = d.dt.dayofweek, d.dt.day, d.dt.month
    both = both.drop(columns=[c for c in (TIME_COL, ID_COL) if c in both.columns])
    for col in both.columns:
        if both[col].dtype == object or str(both[col].dtype) in ("string", "str"):
            both[col] = both[col].astype("category")
    return both.iloc[: len(train)].reset_index(drop=True), both.iloc[len(train):].reset_index(drop=True)


def make_model(seed: int):
    import lightgbm as lgb
    from sklearn.compose import TransformedTargetRegressor

    base = lgb.LGBMRegressor(n_estimators=300, learning_rate=0.05, random_state=seed, verbose=-1)
    if METRIC in ("rmsle",):  # fit log1p(y) so the loss matches the metric
        return TransformedTargetRegressor(regressor=base, func=np.log1p, inverse_func=np.expm1)
    return base


def postprocess_submission(sub, test_pred, classes):
    if METRIC == "rmsle":
        sub[TARGET] = np.clip(sub[TARGET], 0, None)
    return sub
