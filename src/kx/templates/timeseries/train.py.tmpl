def main():
    train, test = _load()
    train = train.sort_values(TIME_COL, kind="stable").reset_index(drop=True)
    out = _output_dir()
    y = train[TARGET]
    folds = np.asarray(assign_folds(train, y, test), dtype=int)
    assert folds.shape == (len(train),), "assign_folds must return one fold id per train row"
    used = sorted(int(f) for f in np.unique(folds) if f >= 0)
    assert used == list(range(N_FOLDS)), f"folds used {used} != range({N_FOLDS})"
    t = pd.to_datetime(train[TIME_COL])
    for k in used[1:]:
        assert t[folds == k].min() > t[folds == k - 1].max(), "walk-forward folds must be in time order"
    X, X_test = build_features(train, test)

    oof = np.full((len(train), 1), np.nan)
    fold_scores = []
    for k in used:
        tr = (folds < k) & (folds >= -1)
        va = folds == k
        assert t[tr].max() < t[va].min(), "a training row is not before its validation window"
        model = make_model(SEED + k)
        model.fit(X[tr], y[tr])
        p_va = np.asarray(model.predict(X[va]), dtype=float)
        oof[va, 0] = p_va
        fold_scores.append(_score(y[va], p_va, None, train[va]))
        print(f"fold {k}: train<{t[va].min().date()} {METRIC}={fold_scores[-1]:.6f}", flush=True)
    model = make_model(SEED)
    model.fit(X, y)
    test_pred = np.asarray(model.predict(X_test), dtype=float).reshape(-1, 1)

    _write_outputs(out, train=train, test=test, y=y, folds=folds, oof=oof, test_pred=test_pred,
                   fold_scores=fold_scores, classes=None, classification=False,
                   extra={"cv_scheme": "walk-forward (expanding window)"})


main()
