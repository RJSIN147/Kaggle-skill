METRIC_INFO = $METRIC_INFO_LIT
N_FOLDS = $N_FOLDS_LIT
SEED = 42
TARGET = None   # None: the sample submission's second column
ID_COL = None   # None: the sample submission's first column
TIME_COL = "date"


