"""kx custom experiment $EXP_ID for $COMPETITION_REF — bring your own pipeline (a Kaggle script kernel).

Write the whole pipeline in run() (the AI BLOCK): any data, model or framework, so this fits
segmentation, detection, LLM, audio, multimodal or artifact competitions. The KX HARNESS is
stdlib-only and enforces just the output contract; kx then records the run fail-closed.

The contract:
- a normal run calls report(fold_scores) exactly once, one score per CV fold (N_FOLDS) in
  METRIC; kx computes the mean and std itself;
- run() writes EXPECTED_OUTPUT into OUT (the submission file or artifact);
- optional: write_preds(oof_rows, test_rows) before report() saves row-level predictions
  (kx-preds/1) so `kx ensemble` can blend this run;
- a time-budget stop: stop_incomplete({...}) and return; `kx run --resume` continues and
  previous_output() finds this kernel's earlier output (checkpoints);
- a code competition's scoring rerun (IS_RERUN): only predict and write EXPECTED_OUTPUT;
- an inference stage (`kx new --after exp-NNN`): read upstream_dir() and call report_upstream().

Edit ONLY the AI BLOCK. The KX HARNESS is hashed at `kx new`; `kx run` refuses a modified
harness. Exceptions are never caught: a throw ends the kernel in ERROR and kx records FAILED.
"""
import csv
import json
import math
import os
import platform
import shutil
import statistics
import sys
import time
from pathlib import Path

EXP_ID = $EXP_ID_LIT
IDEA = $IDEA_LIT
COMPETITION_REF = $COMPETITION_REF_LIT      # canonical case: the Kaggle mount path uses it
SLUG = $SLUG_LIT
SAMPLE_SUBMISSION = $SAMPLE_LIT
EXPECTED_OUTPUT = $OUTPUT_LIT
METRIC = $METRIC_LIT                         # report() scores are in this metric
METRIC_INFO = $METRIC_INFO_LIT
N_FOLDS = $N_FOLDS_LIT
SEED = 42
KERNEL_SLUG = $KERNEL_SLUG_LIT
UPSTREAM = $UPSTREAM_LIT                     # --after: {"ref": "owner/slug", "exp_id": ...}
TIME_BUDGET_S = $TIME_BUDGET_LIT             # 85 % of the runtime limit
MODEL_SOURCES = $MODEL_SOURCES_LIT           # Kaggle Models attached with kx new --model

$HOST_METRIC


# === AI BLOCK: the whole pipeline for this idea ==================================
def run():
    """Load from DATA_DIR, train with CV (N_FOLDS folds, scored in METRIC), call
    report(fold_scores), and write EXPECTED_OUTPUT into OUT. On IS_RERUN only predict
    and write EXPECTED_OUTPUT. Imports for your stack go here."""
    raise NotImplementedError("KX_TODO: write the pipeline for this idea")
# === END AI BLOCK ===============================================================


# === KX HARNESS (do not edit) ===================================================
$PATHS


DATA_DIR = None
OUT = None
IS_RERUN = bool(os.getenv("KAGGLE_IS_COMPETITION_RERUN"))
_STARTED = time.time()
_REPORTED = []
_PREDS = []
_INCOMPLETE = []
_RESERVED = {"exp_id", "metric", "n_folds", "fold_scores", "cv_mean", "cv_std", "seed",
             "submission_file", "predictions", "incomplete", "stopped_at"}


def time_left() -> float:
    """Seconds left before the time budget; stop_incomplete() before it runs out."""
    return TIME_BUDGET_S - (time.time() - _STARTED)


def model_dirs() -> list:
    """Mounted Kaggle Models (kx new --model), in MODEL_SOURCES order."""
    out = []
    for handle in MODEL_SOURCES:
        owner, model, framework, variation, version = handle.split("/")
        p = Path("/kaggle/input/models") / owner / model / framework.lower() / variation / version
        if p.is_dir():
            out.append(p)
    return out


def upstream_dir():
    """kx new --after: the upstream experiment's kernel output (read-only), else None."""
    if not UPSTREAM:
        return None
    owner, slug = UPSTREAM["ref"].split("/", 1)
    for c in (Path("/kaggle/input/notebooks") / owner / slug, Path("/kaggle/input") / slug,
              Path(os.environ.get("KX_UPSTREAM_DIR", "/nonexistent"))):
        if c.is_dir():
            return c
    raise FileNotFoundError(f"upstream output {UPSTREAM['ref']} is not mounted")


def previous_output():
    """kx run --resume: this kernel's own previous output (e.g. checkpoints), else None."""
    cands = [Path("/kaggle/input") / KERNEL_SLUG]
    cands += list(Path("/kaggle/input/notebooks").glob(f"*/{KERNEL_SLUG}"))
    return next((c for c in cands if c.is_dir()), None)


def write_preds(oof_rows, test_rows, classes=None):
    """Row-level predictions in kx-preds/1, so kx can blend this run. Call before report().
    oof_rows: (row_id, fold, target, p...) per train row (fold -1 = never validated);
    test_rows: (row_id, p...) per test row. One p = a probability or a regression value;
    K p's = class probabilities in `classes` order. Never hard labels."""
    if _REPORTED:
        raise RuntimeError("write_preds() must come before report()")
    oof_rows, test_rows = list(oof_rows), list(test_rows)
    if not oof_rows or not test_rows:
        raise ValueError("write_preds() needs oof and test rows")
    k = len(oof_rows[0]) - 3
    if k < 1 or any(len(r) != k + 3 for r in oof_rows) or any(len(r) != k + 1 for r in test_rows):
        raise ValueError("write_preds(): every row needs the same number of predictions")
    if k > 1 and (classes is None or len(classes) != k):
        raise ValueError("write_preds(): K prediction columns need K classes")
    cols = ["pred"] if k == 1 else [f"pred_{i}" for i in range(k)]
    with (OUT / "oof.csv").open("w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["row_id", "fold", "target", *cols])
        for r in oof_rows:
            w.writerow([r[0], int(r[1]), r[2], *[repr(float(v)) for v in r[3:]]])
    with (OUT / "test_preds.csv").open("w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["row_id", *cols])
        for r in test_rows:
            w.writerow([r[0], *[repr(float(v)) for v in r[1:]]])
    _PREDS.append({"format": "kx-preds/1", "oof": "oof.csv", "test": "test_preds.csv",
                   "pred_columns": cols, "classes": [str(c) for c in classes] if k > 1 else None,
                   "n_oof": len(oof_rows), "n_test": len(test_rows)})


def report(fold_scores, **extra):
    """Record the CV: N_FOLDS finite scores in METRIC, once. kx computes mean and std."""
    if _REPORTED:
        raise RuntimeError("report() was already called")
    scores = [float(s) for s in fold_scores]
    if N_FOLDS < 2 or len(scores) != N_FOLDS:
        raise ValueError(f"report() needs {N_FOLDS} fold scores, got {len(scores)}")
    if not all(math.isfinite(s) for s in scores):
        raise ValueError("report(): a fold score is not finite")
    clash = set(extra) & _RESERVED
    if clash:
        raise ValueError(f"report(): reserved keys {sorted(clash)}")
    result = {"exp_id": EXP_ID, "metric": METRIC, "n_folds": N_FOLDS, "fold_scores": scores,
              "cv_mean": statistics.mean(scores), "cv_std": statistics.pstdev(scores),
              "seed": SEED, "submission_file": EXPECTED_OUTPUT, **extra}
    if _PREDS:
        result["predictions"] = _PREDS[0]
    (OUT / "result.json").write_text(json.dumps(result, indent=2))
    _REPORTED.append(result)
    print(f"KX_RESULT {METRIC}={result['cv_mean']:.6f}±{result['cv_std']:.6f}", flush=True)


def report_upstream():
    """An inference stage carries its upstream's CV (and records which run it read)."""
    up = upstream_dir()
    if up is None:
        raise RuntimeError("report_upstream() needs kx new --after")
    res = json.loads((up / "result.json").read_text())
    if res.get("metric") != METRIC:
        raise ValueError(f"upstream metric {res.get('metric')} != {METRIC}")
    if (up / "kx_manifest.json").exists():
        shutil.copy(up / "kx_manifest.json", OUT / "upstream_manifest.json")
    report(res["fold_scores"], stage="infer", cv_source=UPSTREAM)


def stop_incomplete(stopped_at):
    """A clean stop at the time budget: kx records FAILED(runtime_limit), resumable."""
    (OUT / "result.json").write_text(json.dumps({"exp_id": EXP_ID, "incomplete": True,
                                                 "stopped_at": stopped_at}, indent=2))
    _INCOMPLETE.append(stopped_at)
    print(f"KX_INCOMPLETE {stopped_at}: resume with `kx run {EXP_ID} --resume`", flush=True)


def _versions() -> dict:
    from importlib import metadata

    out = {}
    for dist in ("numpy", "pandas", "scikit-learn", "lightgbm", "xgboost", "catboost", "torch",
                 "timm", "transformers", "vllm", "polars"):
        try:
            out[dist] = metadata.version(dist)
        except metadata.PackageNotFoundError:
            continue
    return out


def main():
    global DATA_DIR, OUT
    DATA_DIR = _resolve_data_dir()
    OUT = _output_dir()
    run()
    if _INCOMPLETE:
        return
    if EXPECTED_OUTPUT and not (OUT / EXPECTED_OUTPUT).exists():
        raise FileNotFoundError(f"run() did not write {EXPECTED_OUTPUT} into OUT ({OUT})")
    if IS_RERUN:
        return
    if not _REPORTED:
        raise RuntimeError("run() did not call report(fold_scores)")
    (OUT / "kx_manifest.json").write_text(json.dumps({
        "exp_id": EXP_ID, "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "run_nonce": os.urandom(8).hex(), "python": sys.version.split()[0],
        "platform": platform.platform(), "libraries": _versions(), "data_dir": str(DATA_DIR),
        "kaggle_env_keys": sorted(k for k in os.environ if k.startswith("KAGGLE")),
        "run_type": os.environ.get("KAGGLE_KERNEL_RUN_TYPE")}, indent=2))


main()
