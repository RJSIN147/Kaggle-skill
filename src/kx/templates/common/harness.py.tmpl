def _read(path: Path) -> pd.DataFrame:
    if path.suffix == ".parquet":
        return pd.read_parquet(path)
    return pd.read_csv(path)


def _labels(proba, classes):
    proba = np.asarray(proba, dtype=float)
    if proba.ndim == 1:
        return np.where(proba >= 0.5, classes[1], classes[0])
    return np.asarray(classes)[proba.argmax(axis=1)]


def _score(y_true, pred, classes, rows=None):
    import inspect

    import sklearn.metrics as skm

    if "custom_score" in globals():
        fn = globals()["custom_score"]
        if len(inspect.signature(fn).parameters) >= 3:
            return float(fn(y_true, pred, rows))
        return float(fn(y_true, pred))
    ptype, name = METRIC_INFO["prediction_type"], METRIC
    if ptype == "raw":
        yt, yp = np.asarray(y_true, dtype=float), np.asarray(pred, dtype=float)
        if name == "rmse":
            return float(np.sqrt(np.mean((yt - yp) ** 2)))
        if name == "rmsle":
            return float(np.sqrt(np.mean((np.log1p(np.clip(yp, 0, None)) - np.log1p(yt)) ** 2)))
        return float(getattr(skm, METRIC_INFO["sklearn_callable"])(yt, yp))
    proba = np.asarray(pred, dtype=float)
    if ptype == "proba":
        if name == "roc_auc":
            if proba.ndim == 1:
                return float(skm.roc_auc_score(y_true, proba))
            return float(skm.roc_auc_score(y_true, proba, multi_class="ovr", labels=classes))
        if proba.ndim == 1:
            proba = np.column_stack([1 - proba, proba])
        return float(skm.log_loss(y_true, proba, labels=classes))
    labels = _labels(proba, classes)
    fn = getattr(skm, METRIC_INFO["sklearn_callable"])
    if name == "f1_macro" or (name in ("f1", "precision", "recall") and len(classes) > 2):
        return float(fn(y_true, labels, average="macro"))
    if name == "qwk":
        return float(fn(y_true, labels, weights="quadratic"))
    return float(fn(y_true, labels))


def _versions() -> dict:
    out = {}
    for mod in ("numpy", "pandas", "sklearn", "lightgbm", "xgboost", "catboost", "torch",
                "timm", "transformers"):
        m = sys.modules.get(mod)
        if m is None and mod in ("numpy", "pandas", "sklearn"):
            m = __import__(mod)
        if m is not None:
            out[mod] = getattr(m, "__version__", None)
    return out


def _write_outputs(out, *, train, test, y, folds, oof, test_pred, fold_scores, classes,
                   classification, extra=None):
    """kx-preds/1 files, the submission, result.json and kx_manifest.json."""
    n_cols = oof.shape[1]
    pred_cols = ["pred"] if n_cols == 1 else [f"pred_{i}" for i in range(n_cols)]
    row_ids = train[ID_COL] if ID_COL in train.columns else pd.Series(range(len(train)))
    test_ids = _test_ids(test)
    oof_df = pd.DataFrame(oof, columns=pred_cols)
    oof_df.insert(0, "target", np.asarray(y))
    oof_df.insert(0, "fold", folds)
    oof_df.insert(0, "row_id", row_ids.values)
    oof_df.to_csv(out / "oof.csv", index=False)
    te_df = pd.DataFrame(test_pred, columns=pred_cols)
    te_df.insert(0, "row_id", test_ids.values)
    te_df.to_csv(out / "test_preds.csv", index=False)

    sub = pd.DataFrame({ID_COL: test_ids.values})
    flat = test_pred[:, 0] if n_cols == 1 else test_pred
    if METRIC_INFO["prediction_type"] == "label":
        sub[SUB_TARGET] = _labels(flat, classes)
    elif n_cols == 1:
        sub[SUB_TARGET] = flat
    else:
        for i, c in enumerate(classes):
            sub[str(c)] = test_pred[:, i]
    if "postprocess_submission" in globals():
        sub = globals()["postprocess_submission"](sub, test_pred, classes)
    sub.to_csv(out / EXPECTED_OUTPUT, index=False)

    subsample = os.environ.get("KX_SUBSAMPLE")
    result = {
        "exp_id": EXP_ID, "metric": METRIC, "n_folds": N_FOLDS,
        "fold_scores": [float(s) for s in fold_scores],
        "cv_mean": float(np.mean(fold_scores)), "cv_std": float(np.std(fold_scores)),
        "seed": SEED, "greater_is_better": METRIC_INFO["greater_is_better"],
        "subsample": float(subsample) if subsample else None,
        "predictions": {"format": "kx-preds/1", "oof": "oof.csv", "test": "test_preds.csv",
                        "pred_columns": pred_cols,
                        "classes": [str(c) for c in classes] if n_cols > 1 else None,
                        "n_oof": int(len(oof_df)), "n_test": int(len(te_df)),
                        "id_column": str(ID_COL), "target_column": str(TARGET),
                        "prediction_type": "proba" if classification else "raw"},
        "submission_file": EXPECTED_OUTPUT,
        "sample_columns": [str(c) for c in SAMPLE.columns] if SAMPLE is not None else None,
        "sample_rows": int(len(SAMPLE)) if SAMPLE is not None else None,
    }
    result.update(extra or {})
    (out / "result.json").write_text(json.dumps(result, indent=2))
    import time as _time

    manifest = {
        "exp_id": EXP_ID, "created": _time.strftime("%Y-%m-%dT%H:%M:%SZ", _time.gmtime()),
        "run_nonce": os.urandom(8).hex(),
        "python": sys.version.split()[0], "platform": platform.platform(),
        "libraries": _versions(), "data_dir": str(DATA_DIR),
        "kaggle_env_keys": sorted(k for k in os.environ if k.startswith("KAGGLE")),
        "run_type": os.environ.get("KAGGLE_KERNEL_RUN_TYPE"),
    }
    (out / "kx_manifest.json").write_text(json.dumps(manifest, indent=2))
    print(f"KX_RESULT {METRIC}={result['cv_mean']:.6f}±{result['cv_std']:.6f}", flush=True)


def _setup_columns(sample: pd.DataFrame, train: pd.DataFrame) -> None:
    """ID_COL / SUB_TARGET come from the sample submission; TARGET is the matching
    train column (case-insensitive: digit-recognizer trains on `label`, submits `Label`)."""
    global TARGET, ID_COL, SUB_TARGET, SAMPLE
    SAMPLE = sample
    ID_COL = ID_COL or sample.columns[0]
    SUB_TARGET = sample.columns[1]
    if TARGET is None:
        TARGET = next((c for c in train.columns if str(c) == SUB_TARGET), None) or next(
            (c for c in train.columns if str(c).lower() == str(SUB_TARGET).lower()), SUB_TARGET)


def _test_ids(test: pd.DataFrame) -> pd.Series:
    if ID_COL in test.columns:
        return test[ID_COL]
    if SAMPLE is not None and len(SAMPLE) == len(test):
        return SAMPLE[ID_COL].reset_index(drop=True)  # rows align with test.csv
    return pd.Series(range(len(test)))


def _save_model(model, name: str) -> None:
    """Keep a fitted model in /kaggle/working/models/ for a downstream inference stage
    (our own trusted output; joblib ships with scikit-learn)."""
    import joblib

    d = _output_dir() / "models"
    d.mkdir(exist_ok=True)
    joblib.dump(model, d / f"{name}.joblib")


def _load():
    """Resolve the data, read sample/train/test, apply a local subsample."""
    global DATA_DIR
    DATA_DIR = _resolve_data_dir()
    sample = _read(DATA_DIR / SAMPLE_SUBMISSION)
    train = _read(DATA_DIR / TRAIN_FILE)
    test = _read(DATA_DIR / TEST_FILE)
    _setup_columns(sample, train)
    subsample = os.environ.get("KX_SUBSAMPLE")
    if subsample:
        train = train.sample(frac=float(subsample), random_state=SEED)
        train = train.sort_index().reset_index(drop=True)
    return train, test


DATA_DIR = None
SUB_TARGET = None
SAMPLE = None
